# ---------------------------------------------------------------------------
# environment template — copy to .env.local and fill in.
# NEVER commit real secrets. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database -------------------------------------------------------------
# Production (Turso):
#   TURSO_DATABASE_URL=libsql://<database>-<organisation>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create`>
# Local development (no credentials needed):
#   TURSO_DATABASE_URL=file:./.data/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Sessions -------------------------------------------------------------
# 64+ random characters. Generate with: openssl rand -hex 48
SESSION_SECRET=

# ---- Admin bootstrap (used ONLY by `npm run seed:admin`) -------------------
# Leave empty in production after the first administrator has been created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Storage --------------------------------------------------------------
# 'local' in development, 'blobs' on Netlify. Production fails closed unless
# the durable Blobs driver is selected.
STORAGE_DRIVER=local
# Netlify injects NETLIFY_BLOBS_CONTEXT into function execution automatically;
# do not set or print it. These explicit credentials are only for running the
# Blobs driver outside Netlify and must remain server-only.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
